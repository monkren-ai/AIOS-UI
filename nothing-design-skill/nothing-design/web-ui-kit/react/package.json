{
  "name": "nothing-ui-kit-react",
  "version": "1.0.0",
  "description": "Nothing UI Kit Web - A web component library based on Nothing design system",
  "author": "Nothing UI",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./es/index.d.mts",
      "import": "./es/index.mjs",
      "default": "./es/index.mjs"
    },
    "./styles": {
      "types": "./es/styles/index.d.mts",
      "import": "./es/styles/index.mjs"
    },
    "./es/*": {
      "types": "./es/*.d.mts",
      "import": "./es/*.mjs"
    }
  },
  "main": "es/index.mjs",
  "module": "es/index.mjs",
  "types": "es/index.d.mts",
  "files": [
    "es"
  ],
  "scripts": {
    "dev": "vite",
    "dev:docs": "dumi dev",
    "build": "tsdown",
    "build:packages": "tsx ./scripts/build.ts",
    "build:watch": "tsdown --watch",
    "docs:build": "dumi build",
    "docs:dev": "dumi dev",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "lint:circular": "dpdm src/**/*.{ts,tsx} --warning false --tree false --exit-code circular:1 -T true",
    "type-check": "tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:update": "vitest -u",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "dpdm": "^4.2.0",
    "dumi": "^2.4.34",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.15",
    "prettier": "^3.0.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
